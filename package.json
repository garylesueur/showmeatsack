{
  "name": "showmeatsack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:op": "op run --env-file=.env.development.tpl -- next dev",
    "env": "op inject -i .env.development.tpl -o .env.local",
    "env:vercel": "bash scripts/sync-vercel-env.sh",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && node scripts/check-import-layers.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sparticuz/chromium": "149.0.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "fflate": "^0.8.3",
    "mcp-handler": "^2.1.1",
    "next": "16.3.1",
    "puppeteer-core": "25.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
